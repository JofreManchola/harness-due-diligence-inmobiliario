#!/bin/sh
# Defensa en profundidad para el repo público del harness: el .gitignore ya excluye los casos,
# pero esto también frena un `git add -f` o un dato pegado por error en un archivo del harness.
# Se activa con: git config core.hooksPath harness/git-hooks  (lo hace inicializar_casos.sh)

rutas=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -v '^harness/plantillas/' \
  | grep -E '^casos(/|$)|^inmueble-|(^|/)(perfil-comprador|comparativo|INDICE)\.md$|(^|/)(documentos|texto|fotos|analisis|revision)/|\.(pdf|jpe?g|png|heic|mp4|mov)$')

# Matrículas de Bogotá (50C-/50N-/50S-) y CHIP catastral en líneas agregadas.
datos=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -nE '\b50[CNS]-[0-9]{6,}|\bAAA[0-9]{4}[A-Z0-9]{4}\b')

if [ -n "$rutas$datos" ]; then
  echo "pre-commit: bloqueado, parece contenido privado de un caso." >&2
  [ -n "$rutas" ] && printf 'Rutas:\n%s\n' "$rutas" >&2
  [ -n "$datos" ] && printf 'Datos (matrícula/CHIP):\n%s\n' "$datos" >&2
  echo "Los casos van en casos/ (repo privado). Si es un falso positivo: git commit --no-verify" >&2
  exit 1
fi
